{
  "name": "spur-macos",
  "version": "0.1.0",
  "private": true,
  "description": "A Mac as the agent's body, as a Switch spur.",
  "license": "MIT",
  "repository": "github:zachsents/spur-macos",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt --write .",
    "fix": "bun run lint && bun run format",
    "check": "bun run typecheck && bun run fix"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "effect": "^4.1.5",
    "spur-kit": "github:zachsents/spur-kit#4e6598b"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "ultracite": "^8.3.1"
  },
  "spur": {
    "name": "macos",
    "main": "src/main.ts",
    "needs": [
      "macos"
    ],
    "every": true,
    "widgets": [
      "vitals",
      "screen"
    ],
    "space": {
      "id": "home",
      "name": "Home"
    }
  }
}
